# ──────────────────────────────────────────────────────────────────────────────
# Karima CV Platform — Backend Configuration
# ──────────────────────────────────────────────────────────────────────────────

# Base de données — choisissez UNE option :

# Option A : SQLite (développement, aucune installation requise)
#DATABASE_URL=sqlite+aiosqlite:///./karima_cv.db

# Option B : PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://karima:karima@localhost:5432/hse_cv

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=["*"]

# Auth — JWT secret key (change this in production!)
SECRET_KEY=karima-hse-cv-secret-2026-change-in-prod

# ── AI Model paths (leave empty to auto-detect from old backend directories) ──
# If empty, the system will look in the old backend directories automatically.
# Fill these when you copy/move model files to backend/models/

PPE_MODEL=
PARKING_MODEL=
INTRUSION_MODEL=
INTERACTION_MODEL=
SPEED_MODEL=

# ── Optional overrides ────────────────────────────────────────────────────────
JPEG_QUALITY=72
MAX_FRAME_WIDTH=1280
